generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  type      AccountType

  createdAt DateTime @default(now())

  details   TransactionDetail[]
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Transaction {
  id          String   @id @default(uuid())
  date        DateTime
  description String

  createdAt   DateTime @default(now())

  details     TransactionDetail[]
}

model TransactionDetail {
  id            String   @id @default(uuid())
  transactionId String
  accountId     String

  debit         Float  @default(0)
  credit        Float  @default(0)

  transaction   Transaction @relation(fields: [transactionId], references: [id])
  account       Account     @relation(fields: [accountId], references: [id])
}

model Product {
  id     String @id @default(uuid())
  name   String
  price  Float
  stock  Int
}

model Sale {
  id        String   @id @default(uuid())
  date      DateTime
  total     Float

  details   SaleDetail[]
}

model SaleDetail {
  id        String @id @default(uuid())
  saleId    String
  productId String

  qty       Int
  price     Float

  sale      Sale @relation(fields: [saleId], references: [id])
}

model Voucher {
  id        String   @id @default(uuid())
  code      String   @unique
  value     Float
  balance   Float
  status    String
}

model Receivable {
  id        String   @id @default(uuid())
  customer  String
  total     Float
  paid      Float
  status    String
}

model Payable {
  id        String   @id @default(uuid())
  name      String
  total     Float
  paid      Float
  status    String
}

enum CashFlowType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  KASBON
}

model CashTransaction {
  id          String            @id @default(uuid())
  date        DateTime
  type        CashFlowType
  category    String
  amount      Float
  description String
  source      TransactionSource @default(MANUAL)
  kasbonType  String?
  kasbonRef   String?
  createdAt   DateTime          @default(now())

  @@index([date])
  @@index([type])
  @@index([source])
}
